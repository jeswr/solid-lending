@prefix cred: <https://www.w3.org/2018/credentials#>.
@prefix dcterms: <http://purl.org/dc/terms/>.
@prefix dpv: <https://w3id.org/dpv#>.
@prefix fibo-loan-ln-ln: <https://spec.edmcouncil.org/fibo/ontology/LOAN/LoansGeneral/Loans/>.
@prefix fibo-loan-spc-cns: <https://spec.edmcouncil.org/fibo/ontology/LOAN/LoansSpecific/ConsumerLoans/>.
@prefix lend: <urn:example:lend#>.
@prefix odrl: <http://www.w3.org/ns/odrl/2/>.
@prefix prov: <http://www.w3.org/ns/prov#>.
@prefix schema: <https://schema.org/>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.

<https://maya.pod.example/lending/credentials/income> a cred:VerifiableCredential, lend:EmploymentIncomeCredential;
    cred:issuer <https://verifications.example/orgs/income-verifier#id>;
    cred:validFrom "2026-06-15T12:00:00.000Z"^^xsd:dateTime;
    cred:validUntil "2026-07-29T12:00:00.000Z"^^xsd:dateTime;
    cred:credentialStatus <https://verifications.example/status/employment#54>;
    cred:credentialSubject <https://maya.pod.example/profile/card#me>.
<https://maya.pod.example/profile/card#me> schema:worksFor _:employer;
    schema:jobTitle "Shift Supervisor";
    schema:startDate "2024-11-04"^^xsd:date;
    lend:netMonthlyIncomeUsd 2860.
_:employer a schema:Organization;
    schema:name "Brightline Staffing LLC".
