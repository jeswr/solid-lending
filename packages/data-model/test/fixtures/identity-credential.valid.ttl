@prefix cred: <https://www.w3.org/2018/credentials#>.
@prefix dcterms: <http://purl.org/dc/terms/>.
@prefix dpv: <https://w3id.org/dpv#>.
@prefix fibo-loan-ln-ln: <https://spec.edmcouncil.org/fibo/ontology/LOAN/LoansGeneral/Loans/>.
@prefix fibo-loan-spc-cns: <https://spec.edmcouncil.org/fibo/ontology/LOAN/LoansSpecific/ConsumerLoans/>.
@prefix lend: <urn:example:lend#>.
@prefix odrl: <http://www.w3.org/ns/odrl/2/>.
@prefix prov: <http://www.w3.org/ns/prov#>.
@prefix schema: <https://schema.org/>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.

<https://maya.pod.example/lending/credentials/identity> a cred:VerifiableCredential, lend:IdentityCredential;
    cred:issuer <https://verifications.example/orgs/identity-verifier#id>;
    cred:validFrom "2026-05-16T12:00:00.000Z"^^xsd:dateTime;
    cred:validUntil "2027-05-16T12:00:00.000Z"^^xsd:dateTime;
    cred:credentialStatus <https://verifications.example/status/identity#334>;
    cred:credentialSubject <https://maya.pod.example/profile/card#me>.
<https://maya.pod.example/profile/card#me> schema:name "Maya Torres";
    schema:birthDate "1999-03-14"^^xsd:date;
    schema:address _:identityAddress.
_:identityAddress a schema:PostalAddress;
    schema:streetAddress "2540 Sable Creek Drive";
    schema:addressLocality "Columbus";
    schema:addressRegion "OH";
    schema:postalCode "43219".
