@prefix cred: <https://www.w3.org/2018/credentials#>.
@prefix dcterms: <http://purl.org/dc/terms/>.
@prefix dpv: <https://w3id.org/dpv#>.
@prefix fibo-loan-ln-ln: <https://spec.edmcouncil.org/fibo/ontology/LOAN/LoansGeneral/Loans/>.
@prefix fibo-loan-spc-cns: <https://spec.edmcouncil.org/fibo/ontology/LOAN/LoansSpecific/ConsumerLoans/>.
@prefix lend: <urn:example:lend#>.
@prefix odrl: <http://www.w3.org/ns/odrl/2/>.
@prefix prov: <http://www.w3.org/ns/prov#>.
@prefix schema: <https://schema.org/>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.

<https://maya.pod.example/lending/disbursement> a cred:VerifiableCredential, lend:DisbursementReceiptCredential;
    cred:issuer <https://disbursement.example/orgs/instant-payout#id>;
    cred:validFrom "2026-06-07T12:22:00.000Z"^^xsd:dateTime;
    cred:credentialStatus <https://disbursement.example/status/disbursements#766>;
    cred:credentialSubject <https://maya.pod.example/profile/card#me>;
    prov:wasDerivedFrom <https://maya.pod.example/lending/offer>.
<https://maya.pod.example/profile/card#me> lend:hasDisbursement _:disbursement.
_:disbursement a schema:MoneyTransfer;
    schema:amount _:disbursedAmount;
    schema:startTime "2026-06-07T12:00:00.000Z"^^xsd:dateTime;
    schema:endTime "2026-06-07T12:22:00.000Z"^^xsd:dateTime;
    lend:paymentRail lend:PaymentRail-PushToCard;
    lend:accountLast4 "7758".
_:disbursedAmount a schema:MonetaryAmount;
    schema:value 2000.0;
    schema:currency "USD".
