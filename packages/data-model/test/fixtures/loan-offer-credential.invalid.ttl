@prefix cred: <https://www.w3.org/2018/credentials#>.
@prefix dcterms: <http://purl.org/dc/terms/>.
@prefix dpv: <https://w3id.org/dpv#>.
@prefix fibo-loan-ln-ln: <https://spec.edmcouncil.org/fibo/ontology/LOAN/LoansGeneral/Loans/>.
@prefix fibo-loan-spc-cns: <https://spec.edmcouncil.org/fibo/ontology/LOAN/LoansSpecific/ConsumerLoans/>.
@prefix lend: <urn:example:lend#>.
@prefix odrl: <http://www.w3.org/ns/odrl/2/>.
@prefix prov: <http://www.w3.org/ns/prov#>.
@prefix schema: <https://schema.org/>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.

<https://maya.pod.example/lending/offer> a cred:VerifiableCredential, lend:LoanOfferCredential;
    cred:issuer <https://fintech-lender.example/orgs/installment-lending#id>;
    cred:validFrom "2026-06-05T12:00:00.000Z"^^xsd:dateTime;
    cred:validUntil "2026-06-19T12:00:00.000Z"^^xsd:dateTime;
    cred:credentialStatus <https://fintech-lender.example/status/offers#1011>;
    cred:credentialSubject <https://maya.pod.example/profile/card#me>.
<https://maya.pod.example/profile/card#me> lend:hasLoanOffer _:offeredLoan.
_:offeredLoan a fibo-loan-spc-cns:UnsecuredConsumerLoan, fibo-loan-ln-ln:ClosedEndCredit, schema:LoanOrCredit;
    fibo-loan-ln-ln:hasPrincipalAmount _:principalAmount;
    schema:annualPercentageRate 32.9;
    lend:hasFinanceCharge _:financeCharge;
    lend:hasTotalOfPayments _:totalOfPayments;
    lend:loanTermMonths 18;
    schema:loanRepaymentForm _:paymentSchedule.
_:principalAmount a schema:MonetaryAmount;
    schema:value 2000.0;
    schema:currency "USD".
_:financeCharge a schema:MonetaryAmount;
    schema:value 560.68;
    schema:currency "USD".
_:totalOfPayments a schema:MonetaryAmount;
    schema:value 2400.0;
    schema:currency "USD".
_:paymentSchedule a schema:RepaymentSpecification;
    schema:numberOfLoanPayments 18;
    schema:loanPaymentAmount _:paymentAmount;
    schema:loanPaymentFrequency 12.
_:paymentAmount a schema:MonetaryAmount;
    schema:value 142.26;
    schema:currency "USD".
