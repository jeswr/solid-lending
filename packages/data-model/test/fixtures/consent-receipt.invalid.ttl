<https://maya.pod.example/lending/receipts/1> a dpv:ConsentReceipt;
    dpv:hasDataSubject <https://maya.pod.example/profile/card#me>;
    dpv:hasDataController <https://fintech-lender.example/orgs/installment-lending#id>;
    odrl:target <https://maya.pod.example/lending/credentials/bank-cash-flow>;
    dpv:hasConsentStatus dpv:ConsentRequested;
    dcterms:issued "2026-07-15T12:00:00.000Z"^^xsd:dateTime.
