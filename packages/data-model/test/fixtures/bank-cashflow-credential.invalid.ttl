@prefix cred: <https://www.w3.org/2018/credentials#>.
@prefix dcterms: <http://purl.org/dc/terms/>.
@prefix dpv: <https://w3id.org/dpv#>.
@prefix fibo-loan-ln-ln: <https://spec.edmcouncil.org/fibo/ontology/LOAN/LoansGeneral/Loans/>.
@prefix fibo-loan-spc-cns: <https://spec.edmcouncil.org/fibo/ontology/LOAN/LoansSpecific/ConsumerLoans/>.
@prefix lend: <urn:example:lend#>.
@prefix odrl: <http://www.w3.org/ns/odrl/2/>.
@prefix prov: <http://www.w3.org/ns/prov#>.
@prefix schema: <https://schema.org/>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.

<https://maya.pod.example/lending/credentials/bank-cash-flow> a cred:VerifiableCredential, lend:BankCashFlowCredential;
    cred:issuer <https://verifications.example/orgs/bank-data-provider#id>;
    cred:validFrom "2026-07-12T12:00:00.000Z"^^xsd:dateTime;
    cred:validUntil "2026-08-11T12:00:00.000Z"^^xsd:dateTime;
    cred:credentialStatus <https://verifications.example/status/cash-flow#946>;
    cred:credentialSubject <https://maya.pod.example/profile/card#me>.
<https://maya.pod.example/profile/card#me> schema:owns _:cashFlowAccount;
    lend:hasDepositStream _:depositStream0, _:depositStream1;
    lend:nsf90Count 120;
    lend:hasAverageDailyBalance _:averageDailyBalance;
    lend:observationMonths 12.
_:cashFlowAccount a schema:DepositAccount;
    schema:provider _:cashFlowProvider;
    lend:accountLast4 "3981".
_:cashFlowProvider a schema:Organization;
    schema:name "Clearwater Community Bank".
_:depositStream0 a lend:DepositStream;
    schema:name "Payroll — Brightline Staffing LLC";
    schema:amount _:streamAmount0.
_:streamAmount0 a schema:MonetaryAmount;
    schema:value 2210.0;
    schema:currency "USD".
_:depositStream1 a lend:DepositStream;
    schema:name "Weekend rideshare payouts";
    schema:amount _:streamAmount1.
_:streamAmount1 a schema:MonetaryAmount;
    schema:value 650.0;
    schema:currency "USD".
_:averageDailyBalance a schema:MonetaryAmount;
    schema:value 940.0;
    schema:currency "USD".
