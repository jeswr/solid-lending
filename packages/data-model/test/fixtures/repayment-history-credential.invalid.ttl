@prefix cred: <https://www.w3.org/2018/credentials#>.
@prefix dcterms: <http://purl.org/dc/terms/>.
@prefix dpv: <https://w3id.org/dpv#>.
@prefix fibo-loan-ln-ln: <https://spec.edmcouncil.org/fibo/ontology/LOAN/LoansGeneral/Loans/>.
@prefix fibo-loan-spc-cns: <https://spec.edmcouncil.org/fibo/ontology/LOAN/LoansSpecific/ConsumerLoans/>.
@prefix lend: <urn:example:lend#>.
@prefix odrl: <http://www.w3.org/ns/odrl/2/>.
@prefix prov: <http://www.w3.org/ns/prov#>.
@prefix schema: <https://schema.org/>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.

<https://maya.pod.example/lending/repayment-history> a cred:VerifiableCredential, lend:RepaymentHistoryCredential;
    cred:issuer <https://fintech-lender.example/orgs/installment-lending#id>;
    cred:validFrom "2026-07-13T12:00:00.000Z"^^xsd:dateTime;
    cred:validUntil "2026-08-12T12:00:00.000Z"^^xsd:dateTime;
    cred:credentialStatus <https://fintech-lender.example/status/repayment#737>;
    cred:credentialSubject <https://maya.pod.example/profile/card#me>.
<https://maya.pod.example/profile/card#me> fibo-loan-ln-ln:hasPaymentHistory _:paymentHistory.
_:paymentHistory a fibo-loan-ln-ln:PaymentHistory;
    lend:servicedLoan <https://maya.pod.example/lending/offer>;
    lend:onTimePaymentCount 17;
    lend:latePaymentCount 2;
    lend:scheduledPaymentCount 18;
    schema:startDate "2026-06-07"^^xsd:date;
    schema:endDate "2026-07-13"^^xsd:date.
