# Environment documentation for the Lending walkthrough. Copy the vars you
# need into each app's local env (.env.local) or its Vercel project. The full
# per-project matrix (which var goes on WHICH Vercel project) is docs/deploy.md.

# --- Zone URLs (set on the TOUR/SHELL project only; read at BUILD time) -------
# One per zone app, named LENDING_<APPSLUG>_ZONE_URL, e.g.:
# LENDING_VAULT_ZONE_URL=https://your-vault-deployment.example

# --- Pod-guard rail (each app with authenticated pod routes; fails closed) ----
LENDING_TRUSTED_OIDC_ISSUERS=
LENDING_POD_ALLOWED_ORIGINS=
# Behind a TLS-terminating proxy (Vercel) the forwarded host is authoritative:
# LENDING_TRUST_FORWARDED_HEADERS=1
# Local dev/e2e ONLY (loopback HTTP issuer + in-memory pods); never in production:
# LENDING_DEV_ALLOW_LOOPBACK=1

# --- Seed target (pnpm run seed writes the demo persona here) -----------------
LENDING_SEED_POD_URL=
LENDING_SEED_WEBID=

# --- wallet's Mode-2 grant rail (apps/wallet only; fails closed) --------------
# The wallet's OWN service identity, kept in every rebuilt ACL:
LENDING_WALLET_SERVICE_WEBID=
LENDING_WALLET_POD_SERVICE_ISSUER=
LENDING_WALLET_POD_SERVICE_CLIENT_ID=
LENDING_WALLET_POD_SERVICE_CLIENT_SECRET=
# Operator-pinned party WebIDs a grant may ever target (unset party = absent
# from the dashboard; a change/grant naming it fails closed 503):
LENDING_BANK_LENDER_SERVICE_WEBID=
LENDING_FINTECH_LENDER_SERVICE_WEBID=
LENDING_DISBURSEMENT_SERVICE_WEBID=
# --- fintech-lender (Installment Lending): scene-2/3 issuer allowlists --------
# Issuers trusted to sign the scene-2 ZK operand-anchor VCs (decision 0012).
# The app's own self-hosted demo issuer is always added additionally — see
# lib/server/demo-issuer.ts.
LENDING_TRUSTED_ANCHOR_ISSUERS=
# Issuers trusted to sign the granted credentials scene 3 reads (identity,
# income, bank cash-flow, cash-flow score, credit score).
LENDING_TRUSTED_CREDENTIAL_ISSUERS=
# This lender's own identity — issuer/creator of the offer + repayment-
# history documents it writes. Defaults to the persona-fixture IRI if unset.
LENDING_FINTECH_LENDER_WEBID=

# --- fintech-lender: scene-3/5 service identity (decision-0015-style L4) -----
# The service identity the borrower's grant names for read access to the
# granted credentials and write access to the offer / repayment-history
# documents. Unset ⇒ the origination + servicing rails fail closed (503).
LENDING_FINTECH_SERVICE_WEBID=
LENDING_FINTECH_POD_SERVICE_ISSUER=
LENDING_FINTECH_POD_SERVICE_CLIENT_ID=
LENDING_FINTECH_POD_SERVICE_CLIENT_SECRET=

# --- bank-lender (Personal Loan Desk): scene-2/3 issuer allowlist -------------
# This lender trusts ONLY the credit bureau's issuer here — bureau-only
# decisioning is deliberate (design's inclusion-thesis contrast): it never
# verifies (and so never trusts) the income/cash-flow issuers the
# fintech-lender sibling relies on. The app's own self-hosted demo issuer is
# always added additionally for the scene-2 ZK anchors — see
# lib/server/demo-issuer.ts.
# LENDING_TRUSTED_ANCHOR_ISSUERS and LENDING_TRUSTED_CREDENTIAL_ISSUERS above
# are read here too (shared var names; each app's own Vercel project sets its
# own value).
# This lender's own identity — issuer/agent of the adverse-action notice /
# offer documents it writes. Defaults to the persona-fixture IRI if unset.
LENDING_BANK_LENDER_WEBID=

# --- bank-lender: scene-3 service identity (decision-0015-style L4) ----------
# The service identity the borrower's grant names for read access to the
# GRANTED credit-score credential ONLY, and write access to the
# adverse-action-notice / bank-offer documents. Unset ⇒ the origination rail
# fails closed (503). Must match `LENDING_BANK_LENDER_SERVICE_WEBID` on the
# wallet's Mode-2 dashboard (same identity, different app's own env var name).
LENDING_BANK_SERVICE_WEBID=
LENDING_BANK_POD_SERVICE_ISSUER=
LENDING_BANK_POD_SERVICE_CLIENT_ID=
LENDING_BANK_POD_SERVICE_CLIENT_SECRET=
